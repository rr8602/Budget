@page "/budget"
@rendermode InteractiveServer
@inject BudgetService    BudgetService
@inject FixedItemService FixedItemSvc
@inject ISnackbar        Snackbar
@inject IJSRuntime       JS
@inject NavigationManager NavManager

<PageTitle>예산 관리</PageTitle>

<div class="page-header">
    <div>
        <div class="page-overline">BUDGET MANAGEMENT</div>
        <div class="page-title-row">
            <h1 class="page-title">@(_year)년 @(_month)월 예산</h1>
            <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small"
                           OnClick="PrevMonth" />
            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small"
                           OnClick="NextMonth" Disabled="@IsCurrentMonth" />
        </div>
    </div>
    <MudButton Variant="@(_editMode ? Variant.Filled : Variant.Outlined)"
               Color="Color.Primary"
               StartIcon="@(_editMode ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.Edit)"
               OnClick="() => _editMode = !_editMode">
        @(_editMode ? "편집 완료" : "예산 편집")
    </MudButton>
</div>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Rounded="true" Class="mb-4" />
}

<div class="stat-grid mb-6">
    <div class="stat-card">
        <div class="stat-label">총 예산</div>
        <div class="stat-num">@TotalBudget.ToString("N0")<span class="stat-unit">원</span></div>
        <div class="stat-sub">카테고리 합산</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">이달 지출</div>
        <div class="stat-num">@TotalActual.ToString("N0")<span class="stat-unit">원</span></div>
        <div class="stat-sub">사용률 @UsagePct.ToString("F0")%</div>
    </div>
    <div class="stat-card @(TotalRemaining >= 0 ? "stat-card-accent" : "stat-card-danger")">
        <div class="stat-label">잔액</div>
        <div class="stat-num">@TotalRemaining.ToString("N0")<span class="stat-unit">원</span></div>
        <div class="stat-sub">@(TotalRemaining >= 0 ? "예산 내 지출 중" : "예산 초과")</div>
    </div>
</div>

@if (_rows.Count == 0 && !_loading)
{
    <div class="panel">
        <div class="empty-state">
            <MudIcon Icon="@Icons.Material.Outlined.AccountBalance"
                     Style="font-size:52px;opacity:0.22;" />
            <p style="margin-top:10px;">예산 항목이 없습니다. 설정에서 고정비를 추가해 주세요.</p>
        </div>
    </div>
}
else
{
    <div class="budget-grid">
        @foreach (var row in _rows)
        {
            var editVal   = _editValues.GetValueOrDefault(row.CategoryParentName);
            var total     = row.FixedTotal + editVal;
            var pct       = total > 0 ? Math.Min((double)(row.Actual / total * 100), 100) : 0;
            var barColor  = pct >= 100 ? Color.Error : pct >= 80 ? Color.Warning : Color.Primary;
            var remaining = total - row.Actual;
            var pctClass  = pct >= 100 ? "over" : pct >= 80 ? "warn" : "";
            var name      = row.CategoryParentName;

            <div class="panel budget-cat-card">
                <div class="budget-cat-header">
                    <span class="budget-cat-name">@name</span>
                    <span class="budget-cat-pct @pctClass">@pct.ToString("F0")%</span>
                </div>

                <MudProgressLinear Value="@pct" Color="@barColor"
                                   Rounded="true" Size="Size.Small" Class="mb-2" />

                <div class="budget-cat-amounts">
                    <span class="tbl-muted">지출 @row.Actual.ToString("N0")원</span>
                    <span class="tbl-muted">/</span>
                    <span class="tbl-muted">예산 @total.ToString("N0")원</span>
                    <span style="flex:1;"></span>
                    <span class="@(remaining >= 0 ? "budget-cat-remaining-pos" : "budget-cat-remaining-neg")">
                        @(remaining >= 0 ? "+" : "")@remaining.ToString("N0")원
                    </span>
                </div>

                @if (row.FixedTotal > 0)
                {
                    <div class="budget-cat-fixed">
                        <MudIcon Icon="@Icons.Material.Filled.Lock" Style="font-size:11px;" />
                        고정 @row.FixedTotal.ToString("N0")원 포함
                    </div>
                }

                @* 편집 모드에서만 추가예산 필드 표시 *@
                @if (_editMode)
                {
                    <MudDivider Class="my-3" />
                    <div class="d-flex gap-2 align-center">
                        <MudNumericField T="decimal"
                                         Label="추가 예산"
                                         Value="@editVal"
                                         ValueChanged="@(v => _editValues[name] = v)"
                                         Format="N0" HideSpinButtons="true"
                                         Adornment="Adornment.End" AdornmentText="원"
                                         Variant="Variant.Outlined" Margin="Margin.Dense"
                                         Style="flex:1;" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   Size="Size.Small"
                                   Disabled="@_savingSet.Contains(name)"
                                   OnClick="@(() => SaveAsync(name))">
                            @(_savingSet.Contains(name) ? "저장 중" : "저장")
                        </MudButton>
                    </div>
                }
            </div>
        }
    </div>
}

@* ── 고정비 납부 확인 ── *@
@if (!_loading && _fixedStatuses.Count > 0)
{
    <div id="fixed-confirmation" class="page-header mt-8 mb-4">
        <div>
            <div class="page-overline">FIXED ITEMS CONFIRMATION</div>
            <h2 class="page-title" style="font-size:1.2rem;">고정비 납부 확인</h2>
        </div>
    </div>

    @foreach (var group in _fixedStatuses.GroupBy(s => s.GroupType))
    {
        <div class="panel mb-4">
            <div class="panel-header mb-2">
                <span class="panel-title">@group.Key</span>
            </div>
            @foreach (var item in group)
            {
                var inputVal = _actualInputs.GetValueOrDefault(item.FixedItemId);
                var rowClass = item.IsUnconfirmed ? "fixed-row-unconfirmed"
                             : item.IsShortfall   ? "fixed-row-shortfall"
                             : "fixed-row-ok";
                <div class="fixed-actual-row @rowClass">
                    <div class="fixed-actual-info">
                        <span class="fixed-actual-name">@item.Name</span>
                        <span class="tbl-muted">@item.Owner · 계획 @item.Planned.ToString("N0")원</span>
                    </div>
                    <div class="fixed-actual-controls">
                        <MudNumericField T="decimal?"
                                         Value="@inputVal"
                                         ValueChanged="@(v => _actualInputs[item.FixedItemId] = v)"
                                         Placeholder="실제 납부액"
                                         Format="N0" HideSpinButtons="true"
                                         Adornment="Adornment.End" AdornmentText="원"
                                         Variant="Variant.Outlined" Margin="Margin.Dense"
                                         Style="width:160px;" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   Size="Size.Small"
                                   Disabled="@(_savingFixedSet.Contains(item.FixedItemId) || inputVal is null)"
                                   OnClick="@(() => SaveFixedActualAsync(item.FixedItemId))">
                            확인
                        </MudButton>
                    </div>
                    <span class="fixed-actual-badge">
                        @if (item.IsUnconfirmed)      { <span class="badge-unconfirmed">미입력</span> }
                        else if (item.IsShortfall)    { <span class="badge-shortfall">-@item.Shortfall.ToString("N0")원</span> }
                        else                          { <span class="badge-ok">✓</span> }
                    </span>
                </div>
            }
        </div>
    }
}

@code {
    private int  _year  = DateTime.Today.Year;
    private int  _month = DateTime.Today.Month;
    private bool _loading  = true;
    private bool _editMode = false;

    private List<BudgetEditRow>           _rows               = [];
    private Dictionary<string, decimal>   _editValues         = [];
    private HashSet<string>               _savingSet          = [];

    private List<FixedActualStatus>       _fixedStatuses      = [];
    private Dictionary<int, decimal?>     _actualInputs       = [];
    private HashSet<int>                  _savingFixedSet     = [];
    private bool                          _scrollToFixed;

    private decimal TotalBudget    => _rows.Sum(r => r.FixedTotal + _editValues.GetValueOrDefault(r.CategoryParentName));
    private decimal TotalActual    => _rows.Sum(r => r.Actual);
    private decimal TotalRemaining => TotalBudget - TotalActual;
    private double  UsagePct       => TotalBudget > 0 ? Math.Min((double)(TotalActual / TotalBudget * 100), 200) : 0;
    private bool    IsCurrentMonth => _year == DateTime.Today.Year && _month == DateTime.Today.Month;

    protected override async Task OnInitializedAsync()
    {
        _scrollToFixed = NavManager.Uri.Contains("#fixed-confirmation");
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scrollToFixed && !_loading)
        {
            _scrollToFixed = false;
            await JS.InvokeVoidAsync("themeInterop.scrollToId", "fixed-confirmation");
        }
    }

    private async Task PrevMonth()
    {
        if (_month == 1) { _year--; _month = 12; } else _month--;
        await LoadAsync();
    }

    private async Task NextMonth()
    {
        if (IsCurrentMonth) return;
        if (_month == 12) { _year++; _month = 1; } else _month++;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading        = true;
        _rows           = await BudgetService.GetBudgetEditRowsAsync(_year, _month);
        _editValues     = _rows.ToDictionary(r => r.CategoryParentName, r => r.MonthlyExtra);
        _fixedStatuses  = await FixedItemSvc.GetShortfallStatusAsync(_year, _month);
        _actualInputs   = _fixedStatuses.ToDictionary(s => s.FixedItemId, s => s.Actual);
        _loading        = false;
    }

    private async Task SaveAsync(string name)
    {
        _savingSet.Add(name);
        var ok = await BudgetService.SaveMonthlyExtraAsync(name, _editValues.GetValueOrDefault(name));
        _savingSet.Remove(name);

        if (ok) { Snackbar.Add($"{name} 예산이 저장되었습니다.", Severity.Success); _rows = await BudgetService.GetBudgetEditRowsAsync(_year, _month); }
        else      Snackbar.Add("저장에 실패했습니다.", Severity.Error);
    }

    private async Task SaveFixedActualAsync(int fixedItemId)
    {
        var amount = _actualInputs.GetValueOrDefault(fixedItemId);
        if (amount is null) return;

        _savingFixedSet.Add(fixedItemId);
        var ok = await FixedItemSvc.UpsertActualAsync(fixedItemId, _year, _month, amount.Value);
        _savingFixedSet.Remove(fixedItemId);

        if (ok)
        {
            Snackbar.Add("납부 금액이 저장됐습니다.", Severity.Success);
            _fixedStatuses = await FixedItemSvc.GetShortfallStatusAsync(_year, _month);
        }
        else
        {
            Snackbar.Add("저장에 실패했습니다.", Severity.Error);
        }
    }
}
