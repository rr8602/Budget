@page "/entries/{Id:guid}/edit"
@inject EntryService         EntrySvc
@inject LookupService        LookupSvc
@inject NavigationManager    Nav
@inject ISnackbar            Snackbar
@inject IJSRuntime           JS

<PageTitle>지출 수정</PageTitle>

@if (_entry is not null)
{
    <div class="form-layout entry-form-page">

        @* ── 뒤로가기 / 삭제 버튼 ── *@
        <div style="display:flex;justify-content:space-between;margin-bottom:8px;">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                           OnClick='() => Nav.NavigateTo("/entries")' Size="Size.Small" />
            <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline"
                           Color="Color.Error" OnClick="DeleteAsync" Size="Size.Small" />
        </div>

        @* ── 날짜 + 금액 ── *@
        <div class="panel mb-3">
            <div class="form-section-title">날짜</div>
            <MudDatePicker Label="날짜" @bind-Date="_date"
                           DateFormat="yyyy-MM-dd" Editable="true"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
            <div class="form-section-title">금액</div>
            <AmountKeypad Value="_amount" ValueChanged="v => _amount = v"
                          CategoryId="_categoryId" OnSave="SaveAsync" IsSaving="_saving" />
        </div>

        @* ── 카테고리 ── *@
        <div class="panel mb-3">
            <div class="form-section-title">카테고리</div>
            <CategoryTileGrid SelectedCategoryId="_categoryId"
                              SelectedCategoryIdChanged="v => _categoryId = v" />
        </div>

        @* ── 결제 정보 ── *@
        <div class="panel mb-3">
            <div class="form-section-title">결제 정보</div>
            <div class="d-flex gap-2 mb-2">
                <MudSelect T="int" Label="결제자" @bind-Value="_payerId"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-1">
                    @foreach (var p in _payers)
                    {
                        <MudSelectItem Value="@p.Id">@p.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="int" Label="결제수단" @bind-Value="_paymentMethodId"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-1">
                    @foreach (var m in _methods)
                    {
                        <MudSelectItem Value="@m.Id">@m.Name</MudSelectItem>
                    }
                </MudSelect>
            </div>
            <MudTextField Label="내용 (상호명)" @bind-Value="_content"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
            <MudTextField Label="메모 (선택)" @bind-Value="_memo"
                          Variant="Variant.Outlined" Margin="Margin.Dense" />
        </div>

    </div>
}

<MudMessageBox @ref="_saveBox" Title="수정 확인" YesText="수정" CancelText="취소">
    <MessageContent>수정하시겠습니까?</MessageContent>
</MudMessageBox>
<MudMessageBox @ref="_deleteBox" Title="삭제 확인" YesText="삭제" CancelText="취소">
    <MessageContent>삭제하시겠습니까?</MessageContent>
</MudMessageBox>

@code {
    [Parameter] public Guid Id { get; set; }

    private HouseholdBudget.Data.Entities.Entry? _entry;
    private DateTime? _date;
    private decimal   _amount;
    private int?      _categoryId;
    private int       _payerId;
    private int       _paymentMethodId;
    private string    _content    = "";
    private string?   _memo;
    private bool      _saving;

    private List<HouseholdBudget.Data.Entities.Payer>         _payers  = [];
    private List<HouseholdBudget.Data.Entities.PaymentMethod> _methods = [];
    private MudMessageBox? _saveBox;
    private MudMessageBox? _deleteBox;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("window.scrollTo", 0, 0);
    }

    protected override async Task OnInitializedAsync()
    {
        if (Id == Guid.Empty) return;   // SSR 프리렌더 단계: 파라미터 미설정, 인터랙티브 단계에서 재실행

        _payers  = await LookupSvc.GetPayersAsync();
        _methods = await LookupSvc.GetPaymentMethodsAsync();

        _entry = await EntrySvc.GetByIdAsync(Id);
        if (_entry is null) { Nav.NavigateTo("/entries"); return; }

        _date            = _entry.Date.ToDateTime(TimeOnly.MinValue);
        _amount          = _entry.Amount;
        _categoryId      = _entry.CategoryId;
        _payerId         = _entry.PayerId;
        _paymentMethodId = _entry.PaymentMethodId;
        _content         = _entry.Content;
        _memo            = _entry.Memo;
    }

    private async Task SaveAsync()
    {
        if (_amount <= 0 || _categoryId is null) return;
        if (await _saveBox!.ShowAsync() != true) return;
        _saving = true;
        try
        {
            _entry!.Date            = DateOnly.FromDateTime(_date!.Value);
            _entry.Amount          = _amount;
            _entry.CategoryId      = _categoryId!.Value;
            _entry.PayerId         = _payerId;
            _entry.PaymentMethodId = _paymentMethodId;
            _entry.Content         = _content.Trim();
            _entry.Memo            = string.IsNullOrWhiteSpace(_memo) ? null : _memo.Trim();

            var result = await EntrySvc.UpdateAsync(_entry);
            if (result == true)  { Snackbar.Add("수정되었습니다.", Severity.Success); Nav.NavigateTo("/entries"); }
            else if (result == null) { Snackbar.Add("다른 사람이 먼저 수정하거나 삭제한 항목입니다. 다시 확인해 주세요.", Severity.Warning); Nav.NavigateTo("/entries"); }
            else                       Snackbar.Add("수정에 실패했습니다.", Severity.Error);
        }
        finally { _saving = false; }
    }

    private async Task DeleteAsync()
    {
        if (await _deleteBox!.ShowAsync() != true) return;
        var result = await EntrySvc.DeleteAsync(Id);
        if (result == true)  { Snackbar.Add("삭제되었습니다.", Severity.Info);    Nav.NavigateTo("/entries"); }
        else if (result == null) { Snackbar.Add("이미 삭제된 항목입니다.", Severity.Warning); Nav.NavigateTo("/entries"); }
        else                       Snackbar.Add("삭제에 실패했습니다.", Severity.Error);
    }

}
