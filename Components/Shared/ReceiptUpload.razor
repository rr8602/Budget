@inject IWebHostEnvironment Env
@inject IJSRuntime JS
@implements IDisposable

<div class="receipt-area">
    @* 순수 HTML input — Blazor InputFile 이벤트 버그 우회 *@
    <input type="file" id="@_inputId" accept="image/*" style="display:none;" />

    @if (ReceiptUrl is not null)
    {
        @* ── 첨부된 상태 ── *@
        <div class="receipt-attached">
            <img src="@ReceiptUrl" alt="" class="receipt-img"
                 onerror="this.style.display='none'" />
            <div class="receipt-attached-info">
                <div class="receipt-attached-label">
                    <MudIcon Icon="@Icons.Material.Outlined.TaskAlt"
                             Style="font-size:16px;color:#22C55E;" />
                    <span>영수증 첨부됨</span>
                </div>
                <div class="receipt-attached-actions">
                    <MudButton Size="Size.Small" Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Outlined.Refresh"
                               OnClick="TriggerInput" Disabled="_uploading">
                        교체
                    </MudButton>
                    <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline"
                                   Color="Color.Error" Size="Size.Small"
                                   OnClick="RemoveReceipt" />
                </div>
            </div>
            @if (_uploading)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary"
                                   Rounded="true" Class="mt-1" />
            }
        </div>
    }
    else
    {
        @* ── 미첨부 상태: 업로드 버튼 ── *@
        <div class="receipt-upload-btn @(_uploading ? "receipt-uploading" : "")"
             @onclick="TriggerInput">
            @if (_uploading)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                <span>업로드 중...</span>
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Outlined.AddPhotoAlternate"
                         Style="font-size:26px;opacity:0.45;" />
                <span>영수증 사진 첨부</span>
                <span class="receipt-hint">최대 5MB · JPG, PNG</span>
            }
        </div>
    }

    @if (_errorMessage is not null)
    {
        <MudText Color="Color.Error" Typo="Typo.caption" Class="mt-1">@_errorMessage</MudText>
    }
</div>

@code {
    [Parameter] public string?                  ReceiptUrl        { get; set; }
    [Parameter] public EventCallback<string?>   ReceiptUrlChanged { get; set; }

    private string? _errorMessage;
    private bool    _uploading;
    private readonly string _inputId = $"rcpt-{Guid.NewGuid():N}";
    private DotNetObjectReference<ReceiptUpload>? _dotNetRef;

    protected override void OnInitialized()
    {
        _dotNetRef = DotNetObjectReference.Create(this);
    }

    private async Task TriggerInput()
    {
        try { await JS.InvokeVoidAsync("themeInterop.triggerInput", _inputId, _dotNetRef); }
        catch (JSException) { }
    }

    [JSInvokable]
    public void SetUploading(bool uploading)
    {
        _uploading = uploading;
        _errorMessage = null;
        StateHasChanged();
    }

    [JSInvokable]
    public async Task NotifyUploaded(string url)
    {
        _uploading = false;
        await ReceiptUrlChanged.InvokeAsync(url);
        StateHasChanged();
    }

    [JSInvokable]
    public void NotifyError(string message)
    {
        _uploading = false;
        _errorMessage = message;
        StateHasChanged();
    }

    private async Task RemoveReceipt()
    {
        if (ReceiptUrl is not null)
        {
            var path = Path.Combine(Env.WebRootPath, ReceiptUrl.TrimStart('/'));
            if (File.Exists(path)) File.Delete(path);
        }
        await ReceiptUrlChanged.InvokeAsync(null);
    }

    public void Dispose() => _dotNetRef?.Dispose();
}
