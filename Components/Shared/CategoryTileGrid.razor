@* 카테고리 선택 — 최근 4개 빠른 선택 + 전체 다이얼로그 *@
@inject CategoryService CategorySvc
@inject IJSRuntime JS
@inject IDialogService DialogService

<div class="cat-quick-row">
    @foreach (var cat in _recentCats)
    {
        var isSelected = SelectedCategoryId == cat.Id;
        <MudButton Variant="@(isSelected ? Variant.Filled : Variant.Outlined)"
                   Color="@(isSelected ? Color.Primary : Color.Default)"
                   Class="cat-quick-btn"
                   OnClick="() => SelectQuickAsync(cat)">@cat.Name</MudButton>
    }
    <MudButton Variant="Variant.Outlined" Class="cat-quick-btn cat-quick-all"
               StartIcon="@Icons.Material.Filled.GridView"
               OnClick="OpenDialogAsync">전체</MudButton>
</div>

<style>
    .cat-quick-row {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }
    .cat-quick-btn {
        height: 40px;
        font-size: 0.82rem;
        white-space: nowrap;
        flex: 1;
        min-width: 64px;
    }
    .cat-quick-all {
        border-style: dashed !important;
    }
</style>

@code {
    [Parameter] public int? SelectedCategoryId { get; set; }
    [Parameter] public EventCallback<int> SelectedCategoryIdChanged { get; set; }

    private record RecentCat(int Id, string ParentName, string Name);

    private List<string>    _parentNames = [];
    private List<RecentCat> _recentCats  = [];

    protected override async Task OnInitializedAsync()
    {
        _parentNames = await CategorySvc.GetParentNamesAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadRecentAsync();
    }

    private async Task LoadRecentAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", "hb-recent-cats");
            if (!string.IsNullOrEmpty(json))
            {
                var cats = System.Text.Json.JsonSerializer.Deserialize<List<RecentCat>>(json);
                if (cats?.Count > 0) { _recentCats = cats; StateHasChanged(); return; }
            }
        }
        catch { }

        // 최근 사용 내역 없으면 첫 번째 대분류의 소분류 최대 4개를 기본 표시
        if (_parentNames.Count > 0)
        {
            var defaults = await CategorySvc.GetByParentAsync(_parentNames[0]);
            _recentCats = defaults.Take(4)
                .Select(c => new RecentCat(c.Id, _parentNames[0], c.Name))
                .ToList();
            StateHasChanged();
        }
    }

    private async Task SelectQuickAsync(RecentCat cat)
    {
        await SelectedCategoryIdChanged.InvokeAsync(cat.Id);
        await PushRecentAsync(cat);
    }

    private async Task OpenDialogAsync()
    {
        var opts = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseOnEscapeKey = true
        };
        var p = new DialogParameters<CategoryPickerDialog> { { x => x.SelectedId, SelectedCategoryId } };
        var dialog = await DialogService.ShowAsync<CategoryPickerDialog>("", p, opts);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: CategoryPickerDialog.CategoryPickerResult picked })
        {
            await SelectedCategoryIdChanged.InvokeAsync(picked.Id);
            await PushRecentAsync(new RecentCat(picked.Id, picked.ParentName, picked.Name));
        }
    }

    private async Task PushRecentAsync(RecentCat cat)
    {
        _recentCats.RemoveAll(r => r.Id == cat.Id);
        _recentCats.Insert(0, cat);
        if (_recentCats.Count > 4) _recentCats = _recentCats[..4];
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(_recentCats);
            await JS.InvokeVoidAsync("localStorage.setItem", "hb-recent-cats", json);
        }
        catch { }
    }
}
